# Database (Supabase). Runtime uses DATABASE_URL only; DIRECT_URL is for migrations.
# DATABASE_URL must use the transaction pooler (port 6543) and include: ?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Direct connection to primary (port 5432); required for prisma migrate deploy.
# Include &connect_timeout=10 so migrations fail in ~10s instead of hanging (see docs/prisma-migrate-troubleshooting.md).
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres?sslmode=require&connect_timeout=10"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Twilio (SMS) - Account SID from Twilio console starts with "AC"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# OpenAI (AI assistant)
OPENAI_API_KEY=""

# Email (Resend) — invites, calculator reports, internal signup alerts
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Phase <no-reply@usephase.app>"
# Optional alias for from address (falls back to RESEND_FROM_EMAIL)
# FROM_EMAIL="Phase <no-reply@usephase.app>"
INTERNAL_SIGNUP_NOTIFY_EMAIL="sergio@usephase.app"

# App
APP_TIMEZONE="America/New_York"
# Public app URL for links in emails/SMS/WhatsApp. Production: https://usephase.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Stripe (billing) - Secret key from Developers → API keys; Webhook secret from your webhook; Price IDs from Product catalog (use price_xxx, not prod_xxx)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER_ID=""
STRIPE_PRICE_GROWTH_ID=""
STRIPE_PRICE_SCALE_ID=""

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to the browser for PushManager.subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Optional; defaults to NEXTAUTH_URL or mailto:support@usephase.app
# VAPID_SUBJECT="mailto:ops@yourcompany.com"

# Cron: Flow web-push job (GET/POST /api/cron/flow-push). Use Authorization: Bearer <secret> or x-cron-secret.
# Vercel: add crons in vercel.json; other hosts: schedule curl with this header.
CRON_SECRET=""

# Supabase Storage (optional, for floor plans)
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
