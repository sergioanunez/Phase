// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Runtime Prisma Client uses only DATABASE_URL (pooler). directUrl is used only for migrations/introspection.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PricingTier {
  SMALL
  MID
  LARGE
  WHITE_LABEL
}

enum UserRole {
  Admin
  Superintendent
  Manager
  Subcontractor
  PlatformAdmin
  SUPER_ADMIN
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum TaskStatus {
  Unscheduled
  Scheduled
  PendingConfirm
  Confirmed
  Declined
  InProgress
  Completed
  Canceled
}

/// How a task reached Confirmed status (manual builder action vs contractor SMS).
enum TaskConfirmationSource {
  Manual
  Sms
}

/// Structured reason for a schedule change (analytics + UI labels).
enum TaskRescheduleReason {
  previous_task_incomplete
  trade_unavailable
  material_delay
  inspection_failed
  weather
  scheduling_conflict
  other
}

enum SmsDirection {
  Inbound
  Outbound
}

enum SmsStatus {
  Sent
  Delivered
  Failed
  Received
}

enum SmsMessageType {
  scheduled
  cancelled
  punchlist
  confirmation
  general
}

enum ActivityEventType {
  task_scheduled
  task_rescheduled
  task_cancelled
  task_completed
  task_reported_complete
  task_started
  task_manually_confirmed
  sms_sent
  sms_confirmed
  sms_declined
  punchlist_sent
  punchlist_completed
  inspection_passed
  inspection_failed
  home_started
  home_completed
  assistant_scheduled_task
  assistant_created_punchlist
  assistant_created_material_request
}

enum GateScope {
  DownstreamOnly
  AllScheduling
}

enum GateBlockMode {
  ScheduleOnly
  ScheduleAndConfirm
}

enum PunchCategory {
  Structural
  Framing
  MEP
  Drywall
  Trim
  Paint
  Cabinets
  Flooring
  Fixtures
  Exterior
  Other
}

enum PunchSeverity {
  Minor
  Major
}

enum PunchStatus {
  Open
  ReadyForReview
  Closed
  Canceled
}

enum PlanFileType {
  PDF
  IMAGE
}

enum CompanyStatus {
  ACTIVE
  TRIAL
  DISABLED
  PAST_DUE
}

enum BillingStatus {
  OK
  PAST_DUE
  CANCELED
}

enum NotificationSeverity {
  CRITICAL
  ATTENTION
  INFO
}

enum NotificationCategory {
  SCHEDULE
  QUALITY
  CONTRACTOR
  SYSTEM
}

enum NotificationEntityType {
  HOME
  TASK
  PUNCH
  CONTRACTOR
  USER
  SYSTEM
}

enum NotificationTargetRole {
  SUPERINTENDENT
  MANAGER
  ADMIN
  ANY
}

enum InviteEmailLogStatus {
  SENT
  FAILED
}

enum InviteDeliveryMethod {
  EMAIL
  SMS
  BOTH
}

model Company {
  id                   String       @id @default(cuid())
  name                 String
  slug                 String?      @unique  // e.g. "cullers" for tenant resolution on main domain
  allowedEmailDomains  String[]     @default([])  // e.g. ["cullers.com"] for sign-in by email domain
  pricingTier          PricingTier  @default(SMALL)
  maxActiveHomes  Int?         // null = unlimited
  status          CompanyStatus @default(ACTIVE)
  timezone        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Billing (MVP manual + Stripe)
  monthlyPriceCents Int?
  renewalDate       DateTime?
  billingStatus     BillingStatus?
  notes             String?
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  subscriptionStatus     String?   // Stripe: active, trialing, past_due, canceled, unpaid
  planKey                String?   // starter, growth, unlimited, white_label
  currentPeriodEnd       DateTime?

  // White label (brandLogoUrl kept for legacy; prefer brandLogoPath from uploads)
  brandAppName       String?
  brandLogoUrl       String?
  brandLogoPath      String?   // Supabase path: companies/{id}/branding/logo.{ext}
  brandFaviconPath   String?   // Supabase path: companies/{id}/branding/favicon.{ext}
  brandPrimaryColor  String?
  brandAccentColor   String?

  // Trial
  trialStartsAt     DateTime?
  trialEndsAt       DateTime?
  trialResetCount   Int        @default(0)
  lastTrialResetAt  DateTime?

  /// Billing entitlements: { maxActiveHomes?, maxUsers?, whiteLabelEnabled? }. -1 = unlimited.
  entitlementsJson   Json?
  billingEmail      String?
  onboardingCompleted Boolean   @default(false)

  /// True after trial/demo workspace seed runs once for this tenant.
  demoDataSeeded      Boolean   @default(false)
  /// True after admin clears demo data; prevents re-seeding.
  demoDataCleared     Boolean   @default(false)

  users             User[]
  memberships       CompanyMembership[]
  homes         Home[]
  subdivisions  Subdivision[]
  contractors   Contractor[]
  templateItems WorkTemplateItem[]
  templateDeps  TemplateDependency[]
  homeTasks        HomeTask[]
  punchItems       PunchItem[]
  punchlistShares  PunchlistShare[]
  importBatches   ImportBatch[]
  auditLogs        AuditLog[]
  contractorAssignments ContractorAssignment[]
  homeAssignments HomeAssignment[]
  userInvites   UserInvite[]
  inviteEmailLogs InviteEmailLog[]
  categoryGates          CategoryGate[]
  workTemplateCategories WorkTemplateCategory[]
  smsMessages   SmsMessage[]
  smsMessageLogs SmsMessageLog[]
  notifications Notification[]
  subscriptionEventLogs SubscriptionEventLog[]
  activityEvents ActivityEvent[]
  webPushSubscriptions WebPushSubscription[]
  userWebPushPreferences UserWebPushPreference[]
  taskRescheduleHistory TaskRescheduleHistory[]
  activityNotificationReads ActivityNotificationRead[]

  @@index([pricingTier])
  @@index([status])
  @@index([billingStatus])
}

model SubscriptionEventLog {
  id             String   @id @default(cuid())
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stripeEventId  String   @unique
  eventType      String
  payload        Json?
  createdAt      DateTime @default(now())

  @@index([companyId])
  @@index([stripeEventId])
  @@index([createdAt])
}

model SmsMessageLog {
  id           String   @id @default(cuid())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  direction    String   // SEND | RECEIVE
  to           String?
  from         String?
  status       String   // sent | delivered | failed | etc.
  errorCode    String?
  errorMessage String?
  twilioSid    String?
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
  @@index([status])
}

model User {
  id           String      @id @default(cuid())
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String      @unique
  passwordHash String?
  role         UserRole
  status       UserStatus  @default(ACTIVE)
  contractorId       String?
  contractor         Contractor?  @relation("ContractorUsers", fields: [contractorId], references: [id])
  defaultContactOf   Contractor[] @relation("ContractorDefaultContact")
  isActive           Boolean      @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // NextAuth fields
  emailVerified DateTime?
  image         String?

  // Terms acceptance (signup / trial flow)
  termsAccepted   Boolean   @default(false)
  termsAcceptedAt DateTime?

  // SMS consent (toll-free compliance)
  phoneE164           String?   // E.164; set when subcontractor opts in at invite accept
  smsConsent          Boolean   @default(false)
  smsConsentTimestamp DateTime?
  smsConsentSource    String?
  smsConsentVersion   String?
  smsOptOutAt         DateTime? // set when user replies STOP

  // Relations
  memberships          CompanyMembership[]
  homeAssignments     HomeAssignment[]
  auditLogs           AuditLog[]
  createdPunchItems   PunchItem[]      @relation("PunchItemCreator")
  closedPunchItems     PunchItem[]      @relation("PunchItemCloser")
  planUploadedHomes   Home[]           @relation("PlanUploader")
  homePlansUploaded   HomePlan[]
  invitesCreated      UserInvite[]     @relation("InvitesCreatedBy")
  invites             UserInvite[]     @relation("UserInvites")
  createdNotifications Notification[]  @relation("NotificationCreatedBy")
  importBatchesCreated ImportBatch[]  @relation("ImportBatchesCreatedBy")
  tasksManuallyConfirmed HomeTask[]    @relation("TaskManualConfirm")
  homeTasksReportedComplete HomeTask[] @relation("HomeTaskReportedComplete")
  punchItemsReportedComplete PunchItem[] @relation("PunchItemReportedComplete")
  homeTasksLastRescheduleSnapshot HomeTask[] @relation("TaskLastRescheduledBy")
  taskRescheduleHistory TaskRescheduleHistory[] @relation("RescheduleHistoryActor")
  webPushSubscriptions WebPushSubscription[]
  webPushPrefs         UserWebPushPreference[]
  activityNotificationReads ActivityNotificationRead[]

  @@index([companyId])
  @@index([email])
  @@index([contractorId])
  @@index([phoneE164])
  @@index([role])
  @@index([status])
}

model CompanyMembership {
  id           String   @id @default(cuid())
  companyId    String
  userId       String
  role         UserRole
  contractorId String?
  createdAt    DateTime @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractor Contractor?  @relation(fields: [contractorId], references: [id])
  /// For subcontractor memberships, ties this user to a global subcontractor identity.
  contractorDirectoryId String?
  contractorDirectory   ContractorDirectory? @relation(fields: [contractorDirectoryId], references: [id])

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId])
  @@index([contractorDirectoryId])
}

model UserInvite {
  id                   String                @id @default(cuid())
  companyId            String?
  company              Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                  @relation("UserInvites", fields: [userId], references: [id], onDelete: Cascade)
  email                String
  phoneE164            String?
  inviteDeliveryMethod InviteDeliveryMethod  @default(EMAIL)
  tokenHash            String
  expiresAt            DateTime
  usedAt               DateTime?
  emailSentAt          DateTime?
  smsSentAt            DateTime?
  createdAt            DateTime              @default(now())
  createdByUserId      String
  createdBy            User                  @relation("InvitesCreatedBy", fields: [createdByUserId], references: [id])
  resendCount          Int                   @default(0)

  @@index([companyId])
  @@index([userId])
  @@index([email])
  @@index([phoneE164])
  @@index([tokenHash])
}

model InviteEmailLog {
  id              String              @id @default(cuid())
  companyId       String?
  company         Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId          String?
  email           String
  idempotencyKey  String              @unique
  status          InviteEmailLogStatus
  errorMessage    String?
  createdAt       DateTime            @default(now())

  @@index([companyId])
  @@index([idempotencyKey])
  @@index([createdAt])
}

model Subdivision {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homes Home[]

  @@index([companyId])
  @@index([companyId, name])
  @@index([name])
}

model Home {
  id                   String      @id @default(cuid())
  companyId            String?
  company              Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subdivisionId        String
  subdivision          Subdivision @relation(fields: [subdivisionId], references: [id], onDelete: Cascade)
  addressOrLot         String
  /// Manual build-sequence order within the subdivision (gaps of 100).
  displayOrder         Int         @default(0)
  /// Projected construction start date (used as day 0 for forecasting).
  /// Treated as a working-day anchor (Mon–Fri only in current implementation).
  startDate            DateTime?
  /// Target completion date entered by admin (optional).
  targetCompletionDate DateTime?
  /// Forecast completion date based on working-day durations and dependencies.
  forecastCompletionDate DateTime?
  /// Total forecast duration in working days (from startDate).
  forecastTotalWorkingDays Int?
  /// When the forecast fields were last computed.
  forecastComputedAt   DateTime?
  /// Floor plan: display name (e.g. "Plan 1875", "Model A").
  planName             String?
  /// Floor plan variant (e.g. "A", "B", "Reversed", "Elevation C").
  planVariant          String?
  /// Supabase Storage path only; do not store public URLs.
  planStoragePath      String?
  /// Original filename of uploaded plan (for display); independent from planName.
  planFileName         String?
  planFileType         PlanFileType?
  planUploadedAt       DateTime?
  planUploadedByUserId String?
  planUploadedBy       User?       @relation("PlanUploader", fields: [planUploadedByUserId], references: [id])
  /// House thumbnail image for listing/detail (Supabase Storage path only).
  thumbnailStoragePath String?
  /// Original filename of uploaded thumbnail (for display only).
  thumbnailFileName    String?
  /// Optimized WebP card thumbnail for Homes list (~200px wide, Supabase Storage path only).
  cardThumbnailStoragePath String?
  /// True when all schedule tasks for this home are Completed. Used for billing (active homes = !isComplete).
  isComplete           Boolean     @default(false)
  completedAt         DateTime?
  isDemo               Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tasks            HomeTask[]
  assignments      HomeAssignment[]
  punchItems       PunchItem[]
  punchlistShares  PunchlistShare[]
  smsMessages      SmsMessage[]
  activityEvents   ActivityEvent[]
  contractorAssignments ContractorAssignment[]
  taskRescheduleHistory TaskRescheduleHistory[]
  homePlans             HomePlan[]

  @@index([companyId])
  @@index([companyId, isComplete])
  @@index([companyId, startDate])
  @@index([subdivisionId])
  @@index([subdivisionId, displayOrder])
  @@index([targetCompletionDate])
  @@index([startDate])
}

/// Additional floor / trade plans per home (Supabase storage path). Legacy single plan remains on Home.planStoragePath.
model HomePlan {
  id                 String       @id @default(cuid())
  homeId             String
  companyId          String?
  /// Supabase Storage path (same bucket as Home.planStoragePath); not a public URL.
  storagePath        String
  fileName           String
  tag                String
  planFileType       PlanFileType
  uploadedByUserId   String
  uploadedBy         User         @relation(fields: [uploadedByUserId], references: [id])
  createdAt          DateTime     @default(now())
  home               Home         @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([homeId])
  @@index([homeId, createdAt])
  @@index([companyId])
}

/// Builder-defined phase bucket; ordered by categoryPosition. Work items belong to one category.
model WorkTemplateCategory {
  id               String             @id @default(cuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  /// Sort key for major build phases (gaps of 100).
  categoryPosition Int                @default(100)
  isDemo           Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  templateItems    WorkTemplateItem[]

  @@unique([companyId, name])
  @@index([companyId, categoryPosition])
}

model WorkTemplateItem {
  id                  String        @id @default(cuid())
  companyId           String?
  company             Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  /// Default duration in WORKING DAYS (Mon–Fri).
  defaultDurationDays Int
  sortOrder           Int
  /// Manual display / Flow tie-break order within the tenant (gaps of 100). Synced from category + item order.
  sequenceOrder       Int?
  optionalCategory    String?
  workTemplateCategoryId String?
  workTemplateCategory   WorkTemplateCategory? @relation(fields: [workTemplateCategoryId], references: [id], onDelete: Restrict)
  /// Order within the category (gaps of 100). Primary sort with categoryPosition defines global sequence.
  itemPosition        Int                @default(100)
  isDependency        Boolean       @default(false)
  isCriticalGate      Boolean       @default(false)
  gateScope           GateScope     @default(DownstreamOnly)
  gateBlockMode       GateBlockMode @default(ScheduleOnly)
  gateName            String?
  /// Flow: general prep buffer in working days.
  prepLeadDays        Int           @default(0)
  /// Flow: task requires material ordering before execution.
  requiresOrdering    Boolean       @default(false)
  /// Flow: material lead time in working days (only when requiresOrdering=true).
  materialLeadDays    Int           @default(0)
  /// Assigned contractor for this template; lead time comes from Contractor.leadDays unless contractorLeadOverrideDays is set.
  contractorId        String?
  contractor          Contractor?   @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  /// Optional override for contractor lead days; when set, used instead of Contractor.leadDays.
  contractorLeadOverrideDays Int?
  isDemo              Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  homeTasks HomeTask[]
  // Template-level dependencies
  // Items this template item depends ON
  dependencies TemplateDependency[] @relation("TemplateItemDependencies")
  // Items that depend on this template item
  dependents   TemplateDependency[] @relation("TemplateItemPrerequisites")

  @@index([companyId])
  @@index([companyId, sortOrder])
  @@index([companyId, sequenceOrder])
  @@index([companyId, workTemplateCategoryId, itemPosition])
  @@index([sortOrder])
  @@index([isCriticalGate])
  @@index([contractorId])
}

model HomeTask {
  id                   String           @id @default(cuid())
  companyId            String?
  company              Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  homeId               String
  home                 Home             @relation(fields: [homeId], references: [id], onDelete: Cascade)
  templateItemId       String
  templateItem         WorkTemplateItem @relation(fields: [templateItemId], references: [id])
  nameSnapshot         String
  /// Snapshot of template duration in WORKING DAYS (Mon–Fri).
  durationDaysSnapshot Int
  sortOrderSnapshot    Int
  scheduledDate        DateTime?
  contractorId         String?
  contractor           Contractor?      @relation(fields: [contractorId], references: [id])
  status               TaskStatus       @default(Unscheduled)
  lastConfirmationAt   DateTime?
  /// Set when status becomes Confirmed (SMS or manual).
  confirmedAt          DateTime?
  confirmedByUserId    String?
  confirmedBy          User?            @relation("TaskManualConfirm", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmationSource   TaskConfirmationSource?
  /// When work on this task actually started (field execution).
  startedAt            DateTime?
  completedAt          DateTime?
  /// Flow: when materials were marked ordered (for requiresOrdering tasks).
  orderedAt            DateTime?
  notes                String?
  /// Latest reschedule snapshot (full history in TaskRescheduleHistory).
  lastRescheduleReason      TaskRescheduleReason?
  lastRescheduleNote        String?
  lastRescheduledAt         DateTime?
  lastRescheduledByUserId   String?
  lastRescheduledBy         User?            @relation("TaskLastRescheduledBy", fields: [lastRescheduledByUserId], references: [id], onDelete: SetNull)
  lastPreviousScheduledDate DateTime?
  rescheduleCount           Int              @default(0)
  hasOpenPunch         Boolean          @default(false)
  punchOpenCount       Int              @default(0)
  /// Forecast early start offset from home.startDate in working days.
  forecastEarlyStartOffsetWorkingDays  Int?
  /// Forecast early finish offset from home.startDate in working days.
  forecastEarlyFinishOffsetWorkingDays Int?
  /// True if this task lies on at least one critical path (zero slack).
  isCriticalPath       Boolean          @default(false)
  /// Convenience counter of how many prerequisites this task has.
  blockedByCount       Int              @default(0)
  reportedCompleteAt   DateTime?
  reportedCompleteByUserId String?
  reportedCompleteBy   User?            @relation("HomeTaskReportedComplete", fields: [reportedCompleteByUserId], references: [id], onDelete: SetNull)
  reportedCompleteNote String?
  isDemo               Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  smsMessages SmsMessage[]
  punchItems  PunchItem[]
  rescheduleHistory TaskRescheduleHistory[]

  @@index([homeId])
  @@index([contractorId])
  @@index([status])
  @@index([scheduledDate])
  @@index([templateItemId])
  @@index([hasOpenPunch])
  @@index([confirmedByUserId])
  @@index([lastRescheduledByUserId])
  @@index([reportedCompleteByUserId])
}

/// Immutable log of each task reschedule (analytics + manager timeline).
model TaskRescheduleHistory {
  id                      String               @id @default(cuid())
  companyId               String
  company                 Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  homeId                  String
  home                    Home                 @relation(fields: [homeId], references: [id], onDelete: Cascade)
  taskId                  String
  task                    HomeTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  previousScheduledDate   DateTime
  newScheduledDate        DateTime
  reason                  TaskRescheduleReason
  note                    String?
  rescheduledByUserId     String
  rescheduledBy           User                 @relation("RescheduleHistoryActor", fields: [rescheduledByUserId], references: [id], onDelete: Restrict)
  smsResent               Boolean              @default(false)
  statusBefore            TaskStatus?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([homeId, createdAt])
  @@index([taskId, createdAt])
}

/// Template-level dependencies between work items (DAG).
/// A TemplateDependency defines that templateItemId depends on dependsOnItemId.
model TemplateDependency {
  id              String @id @default(cuid())
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateItemId  String
  dependsOnItemId String
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  templateItem     WorkTemplateItem @relation("TemplateItemDependencies", fields: [templateItemId], references: [id])
  dependsOnItem    WorkTemplateItem @relation("TemplateItemPrerequisites", fields: [dependsOnItemId], references: [id])

  @@unique([templateItemId, dependsOnItemId])
  @@index([companyId])
  @@index([templateItemId])
  @@index([dependsOnItemId])
}

model Contractor {
  id                  String   @id @default(cuid())
  companyId           String?
  company             Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName         String
  contactName         String
  phone               String   // Office phone; not used for SMS. Contacts opt in separately.
  email               String?
  trade               String?
  active              Boolean  @default(true)
  smsEnabled          Boolean  @default(true)
  preferredNoticeDays Int?
  /// Default lead time in working days for Flow prep/Get Ready (source of truth for tasks assigned to this contractor).
  leadDays            Int      @default(0)
  defaultContactId    String?  // User (contact) to use for SMS when task assigned to this vendor
  /// Set when created via bulk import; enables undo last import.
  importBatchId       String?
  importBatch         ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  /// Optional link to global subcontractor identity used for multi-tenant access.
  contractorDirectoryId String?
  contractorDirectory   ContractorDirectory? @relation(fields: [contractorDirectoryId], references: [id])
  isDemo              Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  defaultContact      User?    @relation("ContractorDefaultContact", fields: [defaultContactId], references: [id], onDelete: SetNull)
  users               User[]   @relation("ContractorUsers")
  memberships         CompanyMembership[]
  homeTasks           HomeTask[]
  assignedPunchItems  PunchItem[]
  contractorAssignments ContractorAssignment[]
  templateItems       WorkTemplateItem[]

  @@index([companyId])
  @@index([companyId, active])
  @@index([phone])
  @@index([active])
  @@index([defaultContactId])
  @@index([importBatchId])
  @@index([contractorDirectoryId])
  @@unique([companyId, contractorDirectoryId])
}

/// Global subcontractor identity shared across tenants/companies.
model ContractorDirectory {
  id               String   @id @default(cuid())
  displayName      String
  companyName      String?
  email            String?
  normalizedEmail  String?  @unique
  phone            String?
  normalizedPhone  String?  @unique
  createdAt        DateTime @default(now())

  contractors      Contractor[]
  memberships      CompanyMembership[]
}

model ImportBatch {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy    User     @relation("ImportBatchesCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  contractors  Contractor[]

  @@index([companyId])
  @@index([createdByUserId])
  @@index([createdAt])
}

model ContractorAssignment {
  id           String     @id @default(cuid())
  companyId    String?
  company      Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  homeId       String
  home         Home       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([contractorId, homeId])
  @@index([companyId])
  @@index([contractorId])
  @@index([homeId])
  @@index([companyId, contractorId])
}

model SmsMessage {
  id               String          @id @default(cuid())
  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  direction        SmsDirection
  to               String
  from             String
  body             String
  status           SmsStatus
  messageType      SmsMessageType?
  homeId           String?
  home             Home?           @relation(fields: [homeId], references: [id], onDelete: SetNull)
  homeTaskId       String?
  homeTask         HomeTask?       @relation(fields: [homeTaskId], references: [id])
  recipientName    String?
  confirmationCode String?
  createdAt        DateTime        @default(now())

  @@index([companyId])
  @@index([to])
  @@index([from])
  @@index([homeId])
  @@index([homeTaskId])
  @@index([messageType])
  @@index([confirmationCode])
  @@index([createdAt])
}

/// Activity events for home-level timeline (communication + milestone tracking)
model ActivityEvent {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  homeId        String
  home          Home               @relation(fields: [homeId], references: [id], onDelete: Cascade)
  taskId        String?
  punchItemId   String?
  eventType     ActivityEventType
  title         String
  description   String?
  actorName     String?
  recipientName String?
  metadataJson  Json?
  isDemo        Boolean            @default(false)
  createdAt     DateTime           @default(now())

  @@index([companyId])
  @@index([homeId])
  @@index([taskId])
  @@index([eventType])
  @@index([createdAt])
  @@index([homeId, createdAt])
  @@index([companyId, isDemo])
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entityType  String?
  entityId    String?
  action      String
  beforeJson  String?
  afterJson   String?
  metaJson    Json?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([companyId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model HomeAssignment {
  id                   String   @id @default(cuid())
  companyId            String?
  company              Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  homeId               String
  home                 Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  superintendentUserId String
  superintendent       User     @relation(fields: [superintendentUserId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())

  @@unique([homeId, superintendentUserId])
  @@index([companyId])
  @@index([homeId])
  @@index([superintendentUserId])
}

model PunchItem {
  id                   String        @id @default(cuid())
  companyId            String?
  company              Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  homeId               String
  home                 Home          @relation(fields: [homeId], references: [id], onDelete: Cascade)
  relatedHomeTaskId    String
  relatedHomeTask      HomeTask      @relation(fields: [relatedHomeTaskId], references: [id], onDelete: Cascade)
  createdByUserId      String
  createdBy            User          @relation("PunchItemCreator", fields: [createdByUserId], references: [id])
  assignedContractorId String?
  assignedContractor   Contractor?   @relation(fields: [assignedContractorId], references: [id])
  category             PunchCategory
  severity             PunchSeverity
  title                String
  description          String?
  status               PunchStatus   @default(Open)
  dueDate              DateTime?
  closedAt             DateTime?
  closedByUserId       String?
  closedBy             User?         @relation("PunchItemCloser", fields: [closedByUserId], references: [id])
  reportedCompleteAt   DateTime?
  reportedCompleteByUserId String?
  reportedCompleteBy   User?         @relation("PunchItemReportedComplete", fields: [reportedCompleteByUserId], references: [id], onDelete: SetNull)
  reportedCompleteNote String?
  isDemo               Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  photos PunchPhoto[]

  @@index([homeId])
  @@index([relatedHomeTaskId])
  @@index([createdByUserId])
  @@index([assignedContractorId])
  @@index([status])
  @@index([category])
  @@index([reportedCompleteByUserId])
}

model PunchPhoto {
  id          String    @id @default(cuid())
  punchItemId String
  punchItem   PunchItem @relation(fields: [punchItemId], references: [id], onDelete: Cascade)
  imageUrl    String
  createdAt   DateTime  @default(now())

  @@index([punchItemId])
}

/// Secure public view for subcontractors: one share per task send (tokenized link in SMS).
model PunchlistShare {
  id                String    @id @default(cuid())
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  homeId            String
  home              Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homeTaskId        String    // task whose punch items are included
  token             String    @unique
  enabled           Boolean   @default(true)
  dueDate           DateTime?
  recipientPhone    String?   // optional; first recipient or null
  sentAt            DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([companyId])
  @@index([homeId])
  @@index([homeTaskId])
  @@index([token])
}

model CategoryGate {
  id                String        @id @default(cuid())
  companyId         String?
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryName      String
  gateScope         GateScope     @default(DownstreamOnly)
  gateBlockMode     GateBlockMode @default(ScheduleOnly)
  gateName          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([companyId, categoryName])
  @@index([companyId])
  @@index([categoryName])
}

model Notification {
  id                String                   @id @default(cuid())
  companyId         String
  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  severity          NotificationSeverity
  category          NotificationCategory
  title             String
  message           String
  entityType        NotificationEntityType
  entityId          String?
  homeId            String?
  createdByUserId   String?
  createdBy         User?                    @relation("NotificationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  targetRole        NotificationTargetRole
  targetUserId      String?
  requiresAction    Boolean                  @default(false)
  reviewedAt        DateTime?
  resolvedAt       DateTime?
  expiresAt        DateTime?
  isDemo           Boolean                  @default(false)
  createdAt         DateTime                 @default(now())

  @@index([companyId])
  @@index([homeId])
  @@index([targetUserId])
  @@index([companyId, entityType, entityId, category, severity])
  @@index([createdAt])
  @@index([companyId, isDemo])
}

/// Browser Web Push subscription (VAPID). Scoped to user + tenant.
model WebPushSubscription {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@index([userId, companyId])
  @@index([companyId])
}

/// Per-tenant push category toggles for a user (browser push only).
model UserWebPushPreference {
  id                       String   @id @default(cuid())
  userId                   String
  companyId                String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enabled                  Boolean  @default(true)
  notifySubcontractorReply Boolean  @default(true)
  notifyFlowAlerts         Boolean  @default(true)
  notifyPunchlist          Boolean  @default(true)
  updatedAt                DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Short-lived keys to avoid duplicate operational pushes (e.g. Flow fingerprint).
model WebPushDedup {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Subcontractor "mark read" for synthetic activity notifications (audit-derived), per user + tenant.
model ActivityNotificationRead {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activityKey String
  readAt      DateTime @default(now())

  @@unique([userId, activityKey])
  @@index([userId, companyId])
}

/// Lead capture from public marketing tools (e.g. Delay Cost Calculator).
model MarketingToolLead {
  id           String   @id @default(cuid())
  email        String
  firstName    String?
  source       String
  formVariant  String?
  inputs       Json
  results      Json
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([source, createdAt])
}
